# Contact Form Configuration (Optional)
# In development, if credentials are not set, submissions are saved locally to messages.txt.

# Option 1: Resend API Key (Recommended for Vercel/serverless)
# Current sender onboarding@resend.dev is for testing; verify a sending domain for production.
RESEND_API_KEY=your_resend_api_key

# Option 2: Gmail SMTP App Password (Google Account > Security > App Passwords)
# NOTE: The Gmail SMTP username must match the authenticated Gmail account.
# The current API route uses CONTACT_EMAIL as its SMTP login user, so an Outlook
# CONTACT_EMAIL will not authenticate with Gmail. This needs separating before use.
GMAIL_APP_PASSWORD=your_gmail_app_password

# Optional: Recipient Email Override (defaults to email in src/lib/site.ts)
CONTACT_EMAIL=your_email@example.com

# Analytics Configuration (Optional)
# If omitted, Google Analytics is disabled with zero errors or bundle overhead.
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Public Supabase configuration (publishable key only; never a secret/service-role key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
